      "target": "plugin::users-permissions.user"
    },
    "userId": {
      "type": "integer"
    },
    "userEmail": {
      "type": "string"
    },
    "userRole": {
      "type": "string"
    },
    "changes": {
      "type": "json"
    },
    "ipAddress": {
      "type": "string"
    },
    "userAgent": {
      "type": "string"
    }
  }
